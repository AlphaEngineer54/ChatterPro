# =============================================================================
#  ChatterPro — Modèle de variables d'environnement (docker-compose)
#  Copiez ce fichier en `.env` puis renseignez les valeurs :
#      cp .env.example .env
#  `docker-compose up -d --build` lira le `.env` pour interpoler les ${VARIABLES}.
# =============================================================================

# ── Général ──────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ── Ports exposés sur l'hôte ─────────────────────────────────────────────────
GATEWAY_PORT=5000
AUTHSERVICE_PORT=5001
USERSERVICE_PORT=5002
MESSAGESERVICE_PORT=5003
DATAEXPORT_PORT=5004
NOTIFSERVICE_PORT=5005

# ── Sécurité JWT ─────────────────────────────────────────────────────────────
# DOIT être identique pour AuthService (émission) et Gateway (validation).
# ≥ 32 caractères (256 bits) pour HMAC-SHA256. NE PAS committer de vraie clé.
JWT_SECRET=change-me-with-a-long-random-secret-of-32-chars-min

# ── MySQL (identifiants partagés par les 4 bases) ────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=chatter
MYSQL_PASSWORD=change-me

# ── Chaînes de connexion EF Core (hôte = nom du service docker) ──────────────
AUTHSERVICE_DB_CONNECTION=server=auth-db;port=3306;database=auth_db;user=chatter;password=change-me
USERSERVICE_DB_CONNECTION=server=user-db;port=3306;database=user_db;user=chatter;password=change-me
MESSAGESERVICE_DB_CONNECTION=server=message-db;port=3306;database=message_db;user=chatter;password=change-me
NOTIFICATIONSERVICE_DB_CONNECTION=server=notification-db;port=3306;database=notification_db;user=chatter;password=change-me

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
# Variables consommées par le code des services (.NET)
RABBIT_MQ_HOST=rabbitmq
RABBIT_MQ_PORT=5672
RABBIT_MQ_USER=guest
RABBIT_MQ_PASSWORD=guest

FRONTEND_PORT=3000
VITE_GATEWAY_URL=http://localhost:5000
VITE_CHAT_HUB_URL=http://localhost:5003/hubs/chat
VITE_FRONTEND_PORT=3000
VITE_CHAT_HUB_URL=http://localhost:5003/hubs/chat

