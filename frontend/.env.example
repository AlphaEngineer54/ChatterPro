# =============================================================================
#  Frontend (React + Vite) — variables d'environnement
#  Copiez en `.env`. Les variables VITE_* sont injectées au build.
# =============================================================================

# API Gateway Ocelot (REST : auth, conversations, messages)
VITE_GATEWAY_URL=http://localhost:5000

# Hub SignalR de MessageService (connexion DIRECTE — Ocelot ne route pas les WebSockets)
VITE_CHAT_HUB_URL=http://localhost:5003/hubs/chat
