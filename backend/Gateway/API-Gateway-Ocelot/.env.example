# =============================================================================
#  API Gateway (Ocelot) — variables d'environnement
#  En Docker, fournies par le `.env` racine via docker-compose.
#  La Gateway VALIDE le JWT : JWT_SECRET doit être identique à celui de l'AuthService.
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# JWT — DOIT être identique à celui de l'AuthService
JWT_SECRET=change-me-with-a-long-random-secret-of-32-chars-min
