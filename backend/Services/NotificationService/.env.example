# =============================================================================
#  NotificationService — variables d'environnement
#  En Docker, fournies par le `.env` racine via docker-compose.
#  Expose le Hub SignalR NotificationHubs sur /notifications (direct, 5005).
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5005

# Base de données (MySQL)
NOTIFICATIONSERVICE_DB_CONNECTION=server=notification-db;port=3306;database=notification_db;user=chatter;password=change-me

# RabbitMQ
RABBIT_MQ_HOST=rabbitmq
RABBIT_MQ_PORT=5672
RABBIT_MQ_USER=guest
RABBIT_MQ_PASSWORD=guest
