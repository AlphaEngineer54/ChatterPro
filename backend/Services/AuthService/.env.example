# =============================================================================
#  AuthService — variables d'environnement
#  En Docker, ces valeurs sont fournies par le `.env` racine via docker-compose.
#  Pour un lancement isolé (`dotnet run`), copiez en `.env` et chargez-les dans
#  votre shell (ou via env_file). Hôtes = noms des services docker.
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5001

# Base de données (MySQL)
AUTHSERVICE_DB_CONNECTION=server=auth-db;port=3306;database=auth_db;user=chatter;password=change-me

# JWT — DOIT être identique à celui de la Gateway
JWT_SECRET=9f7c4d8a2e6b1f5c3a9d7e4b8f0c6a1e5d9b3f7a2c8e4d6f1b9a0c5e7d3f8a

# RabbitMQ
RABBIT_MQ_HOST=rabbitmq
RABBIT_MQ_PORT=5672
RABBIT_MQ_USER=guest
RABBIT_MQ_PASSWORD=guest
