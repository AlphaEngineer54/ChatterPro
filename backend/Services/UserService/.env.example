# =============================================================================
#  UserService — variables d'environnement
#  En Docker, fournies par le `.env` racine via docker-compose.
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5002

# Base de données (MySQL)
USERSERVICE_DB_CONNECTION=server=user-db;port=3306;database=user_db;user=chatter;password=change-me

# RabbitMQ
RABBIT_MQ_HOST=rabbitmq
RABBIT_MQ_PORT=5672
RABBIT_MQ_USER=guest
RABBIT_MQ_PASSWORD=guest
