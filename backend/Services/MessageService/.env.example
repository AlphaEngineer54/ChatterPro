# =============================================================================
#  MessageService — variables d'environnement
#  En Docker, fournies par le `.env` racine via docker-compose.
#  Expose aussi le Hub SignalR ChatHub sur /hubs/chat (connexion directe, 5003).
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5003

# Base de données (MySQL)
MESSAGESERVICE_DB_CONNECTION=server=message-db;port=3306;database=message_db;user=chatter;password=change-me

# RabbitMQ
RABBIT_MQ_HOST=rabbitmq
RABBIT_MQ_PORT=5672
RABBIT_MQ_USER=guest
RABBIT_MQ_PASSWORD=guest
